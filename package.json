{
  "name": "miniforce-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @miniforce/web dev",
    "build:web": "pnpm --filter @miniforce/web build",
    "test:api": "cd services/api && PYTHONPATH=. .venv/bin/pytest tests/ -v",
    "dev:api": "cd services/api && PYTHONPATH=. .venv/bin/uvicorn app.main:app --reload --port 8000"
  }
}
