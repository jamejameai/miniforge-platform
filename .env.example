# ==========================================
# MiniForge Root Environment Configuration
# ==========================================

# Backend API Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-for-production
ENCRYPTION_MASTER_KEY=change-this-to-a-base64-encoded-32-byte-key-for-aes-encryption

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@localhost:5432/miniforge
DATABASE_URL=sqlite+aiosqlite:///./miniforge_dev.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Defaults (for local sandbox testing)
TELEGRAM_BOT_TEST_TOKEN=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

